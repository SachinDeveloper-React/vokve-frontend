# Where the site reads its content: the backend's /v1 base. Every page is
# served by it and edited on the panel's Website pages (RULES P22). Set it in
# production. Leave empty only to work on the design with the mock content in
# src/content/mock (docs/CONTENT_API.md).
# e.g. https://api.vokve.com/v1
VOKVE_CONTENT_API_URL=

# Optional, for local design work: with VOKVE_CONTENT_API_URL empty, read just
# the live contact details from here (GET /site/company) while the copy stays
# on the mocks. The contact form also posts here then.
VOKVE_API_URL=

# Shared secret with the backend (its SITE_REVALIDATE_SECRET): the key for
# POST /api/revalidate, which the backend calls after every save, and the
# proof sent with the contact form so the backend limits each visitor rather
# than this server as one. Leave empty to disable the route.
CONTENT_REVALIDATE_SECRET=

# Where the site reads its content: the backend's /v1 base.
# Leave empty to use the mock content in src/content/mock (docs/CONTENT_API.md).
VOKVE_CONTENT_API_URL=

# The backend's /v1 base for what it serves today: the contact details the CRM
# edits (GET /site/company). Set this alone to keep the copy on the mocks while
# the email, numbers, address and store links are the live ones.
# e.g. https://vokve-backend-src.vercel.app/v1
VOKVE_API_URL=

# Shared secret for POST /api/revalidate (the backend calls it after an edit —
# the same value as the backend's SITE_REVALIDATE_SECRET). Leave empty to
# disable the route.
CONTENT_REVALIDATE_SECRET=
